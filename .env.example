# Copy to .env and fill in real values:
#   cp .env.example .env

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# ============================================================================
# API KEYS
# ============================================================================
# Google Gemini (embeddings + text generation / RAG)
GEMINI_API_KEY=

# Optional: used as fallback for Gemini if GEMINI_API_KEY is unset
VERTEX_AI=

# Landing AI (document parsing). Alias: VISION_AGENT_API_KEY is also accepted.
LANDING_AI_API_KEY=

# ============================================================================
# EMBEDDING & GENERATION
# ============================================================================
# Gemini embedContent only. Legacy models/embedding-001 was removed from the API (404).
# Use models/gemini-embedding-001 (text) or models/gemini-embedding-2-preview (multimodal).
# EMBEDDING_DIMENSIONS must match your pgvector column (gemini-embedding-001 supports 768, 1536, 3072, …).
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Text generation model for RAG/workflows, e.g. gemini-2.5-pro, gemini-2.5-flash
GEMINI_GENERATION_MODEL=gemini-2.5-pro

# ============================================================================
# FILE UPLOADS
# ============================================================================
UPLOAD_DIR=/tmp
MAX_FILE_SIZE=10485760

# ============================================================================
# AWS S3 (optional — enable when storing uploads in S3)
# ============================================================================
S3_ENABLED=false
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
